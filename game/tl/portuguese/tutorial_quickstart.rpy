    old "Yes, I do."
    new "Sim, eu gosto."

    # game/tutorial_quickstart.rpy:502
    old "No, I don't."
    new "Não, eu não gosto."

    # game/tutorial_quickstart.rpy:589
    old "What's your name?"
    new "Qual é o seu nome?"

